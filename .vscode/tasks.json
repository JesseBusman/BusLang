{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake-configure",
			"type": "shell",
			"command": "cmake",
			"args": ["-B", "build", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug"],
			"problemMatcher": []
		},
		{
			"label": "ninja-build",
			"type": "shell",
			"command": "cd build && ninja",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": "cmake-configure",
			"problemMatcher": ["$nvcc"]
		}
	]
}

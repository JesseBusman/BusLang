require mul_range_same proves forany a: MUL_RANGE a a == a
by (
	forany a:
	defeq2 MUL_RANGE.x
);

require mul_range_other proves forany a,b: a <= b  ->  a != b  ->  MUL_RANGE a b == a * MUL_RANGE a++ b
by (
	forany a,b:
	assume a_le_b proves a <= b;
	assume a_neq_b proves a != b;
	(defeq2 MUL_RANGE.xx) < (impl_impl_and < a_le_b < a_neq_b)
);

require mul_succ_same__mul_range proves forany a,b: a : UINT  ->  b : UINT  ->  a++ == b  ->  a * b == MUL_RANGE a b
by (
	forany a,b:
	assume auint proves a : UINT;
	assume buint proves b : UINT;
	assume sa_b proves a++ == b;
	
	require temp1 proves a * b == a * b
	by eq_same;
	
	require temp2 proves a * b == a * MUL_RANGE b b
	by temp1 > ((mul_range_same > eq_comm) > bin_sub_right_eq) > bin_sub_right_impl;
	
	require temp3 proves a * b == a * MUL_RANGE a++ b
	by temp2 > (((sa_b > eq_comm) > bin_sub_left_eq) > bin_sub_right_eq) > bin_sub_right_impl;
	
	require a_le_b proves a <= b by (le_succ_self < auint) > sa_b > bin_sub_right_impl;
	require a_neq_b proves a != b by (uint_neq_succ_self < auint) > (sa_b > bin_sub_right_eq) > bin_sub_left_impl;
	
	require temp4 proves a * b == MUL_RANGE a b
	by temp3 > ((mul_range_other < a_le_b < a_neq_b) > eq_comm) > bin_sub_right_impl;
	
	temp4
);


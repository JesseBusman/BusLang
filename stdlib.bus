	assume A_eq_B proves eq a b;
	assume B_eq_C proves eq b c;
	A_eq_B > B_eq_C > bin_sub_right_impl
);

require neq_comm proves forany a,b: a != b  ->  b != a
by (
	forany a,b:
	assume ab proves a != b;
	assume ba proves b == a;

);

require neq_same proves forany a: !(a != a)
by eq_same > impl_not_not;




require not_impl__or proves forany a,b: (!a -> b)  ->  a || b
by (
	forany a,b:
	assume NA_B proves !a -> b;
	wrap or (
		assume NA_AND_NB proves !a && !b;
		(NA_AND_NB > and_left) > ((NA_AND_NB > and_right) > (NA_B > impl_reverse))
	)
);

require or_left proves forany a,b: a  ->  a || b
by (
	forany a,b:
	assume A proves a;
	wrap or (
		assume NA_and_NB proves !a && !b;
		A > (NA_and_NB > and_left)
	)
);

require or_right proves forany a,b: b  ->  a || b
by (
	forany a,b:
	assume B proves b;
	wrap or (
		assume NA_and_NB proves !a && !b;
		B > (NA_and_NB > and_right)
	)
);

require or_impl_left proves forany a,b,c: ((a || b) -> c) -> (a -> c)
by (
	forany a,b,c:
	assume OR_AB_C proves (a || b) -> c;
	assume A proves a;
	((A > or_left) > OR_AB_C)
);

require or_impl_right proves forany a,b,c: ((a || b) -> c) -> (b -> c)
by (
	forany a,b,c:
	assume OR_AB_C proves (a || b) -> c;
	assume B proves b;
	((B > or_right) > OR_AB_C)
);

require or_comm_impl proves forany a,b: a || b  ->  b || a
by (
	forany a,b:
	assume A_OR_B proves a || b;
	require A_IMPL_B_OR_A proves a -> b || a by or_right;
	require B_IMPL_B_OR_A proves b -> b || a by or_left;
	B_IMPL_B_OR_A > A_IMPL_B_OR_A > A_OR_B > or_cases
);

require or_comm_eq proves forany a,b: eq (or a b) (or b a)
by  wrap eq ( impl_impl_and < or_comm_impl < or_comm_impl );

require false_false__not_or proves forany a,b: !a -> !b -> !(a || b)
by (
	forany a,b:
	assume NA proves !a;
	assume NB proves !b;
	assume OR_AB proves or a b;
	require OR_AB_ proves (AND !a !b) -> FALSE
	by unwrap or OR_AB;
	(NB > NA > impl_impl_and) > OR_AB_
);





syntax (a++) = UINT_SUCC a, precedence 20000, associativity left;

print _UINT_has_member_UINT_ZERO;
print _UINT_has_member_UINT_SUCC;

require zero_is_uint proves UINT_ZERO : UINT  by  _UINT_has_member_UINT_ZERO;
require succ_uint_is_uint proves forany a: (a : UINT) -> HAS_MEMBER UINT (UINT_SUCC a)  by
	(forany a: assume auint proves a : UINT;  _UINT_has_member_UINT_SUCC < auint);
require succ_not_zero proves forany a: a : UINT -> (UINT_SUCC a) != UINT_ZERO
by (
	forany a:
	assume auint proves a : UINT;
	(_neq_UINT_UINT_ZERO_UINT_SUCC < auint) > neq_comm
);

require uint_is_zero_or_succ_new proves forany a: a : UINT  ->  or (eq a UINT_ZERO) ((forany b: (HAS_MEMBER UINT b && (eq a (UINT_SUCC b)) -> FALSE)) -> FALSE) by (
	forany a:
	assume auint proves a : UINT;
	(auint > _UINT_is_one_of) > (not_not_eq > bin_sub_left_impl)
);

require uint_is_zero_or_succ proves forany a: a : UINT  ->  or (eq a UINT_ZERO) ((forany b: (HAS_MEMBER UINT b -> (eq a (UINT_SUCC b)) -> FALSE)) -> FALSE) by (
	forany a:
	assume auint proves a : UINT;
	
	or_cases < (uint_is_zero_or_succ_new < auint) < (
		assume ass proves eq a UINT_ZERO;
		ass > or_left
	) < (
		assume ass proves (forany b: (HAS_MEMBER UINT b && (eq a (UINT_SUCC b)) -> FALSE)) -> FALSE;
		
		or_right < (
			
			// Goal:
			// (forany b: (HAS_MEMBER UINT b -> (eq a (UINT_SUCC b)) -> FALSE)) -> FALSE
			
			assume ass2 proves forany b: HAS_MEMBER UINT b -> (eq a (UINT_SUCC b)) -> FALSE;
			
			// Goal: FALSE
			
			ass < (
				// Goal:
				// forany b: HAS_MEMBER UINT b && (eq a (UINT_SUCC b)) -> FALSE
				
				forany b:
				assume ass3 proves HAS_MEMBER UINT b && (eq a (UINT_SUCC b));
				
				// Goal: FALSE
				
				ass2 < (
					ass3 > and_left
				) < (
					// Goal:
					// (eq a (UINT_SUCC b))
					ass3 > and_right
				)
			)
		)
	)
);

assume uint_inductive proves forany a,P: P UINT_ZERO -> (forany b: (b : UINT) -> P b -> P (UINT_SUCC b)) -> (a : UINT) -> P a;

define UINT_ONE = UINT_SUCC UINT_ZERO;
define UINT_TWO = UINT_SUCC UINT_ONE;

define UINT_PRED {
	a: (UINT_SUCC a) | a : UINT = a;
	;
};

require uint_pred proves forany a: (a : UINT) -> eq (UINT_PRED (UINT_SUCC a)) a by (
	forany a:
	assume auint proves a : UINT;
	eq_same > (defeq2 UINT_PRED.x < auint) > bin_sub_right_impl
);


define UINT_ADD {
	a  : a UINT_ZERO     | a : UINT                 = a,
	a,b: a (UINT_SUCC b) | (a : UINT) && (b : UINT) = UINT_SUCC (UINT_ADD a b);
	(
		forany a1,a2,b2:
		assume condition_1 proves a1 : UINT;
		assume condition_2 proves (a2 : UINT) && (b2 : UINT);
		(_neq_UINT_UINT_ZERO_UINT_SUCC < (condition_2 > and_right)) > or_right
	);
};
syntax (a + b) = UINT_ADD a b, precedence 200, associativity left;



define UINT_MUL {
	a:   a UINT_ZERO     | a : UINT                 = UINT_ZERO,
	a,b: a (UINT_SUCC b) | (a : UINT) && (b : UINT) = (UINT_ADD (UINT_MUL a b) a);
	(
		forany a1,a2,b2:
		assume condition_1 proves a1 : UINT;
		assume condition_2 proves (a2 : UINT) && (b2 : UINT);
		(_neq_UINT_UINT_ZERO_UINT_SUCC < (condition_2 > and_right)) > or_right
	);
};
syntax (a * b) = UINT_MUL a b, precedence 210, associativity left;

define UINT_POW {
	a:   a UINT_ZERO     | a : UINT                 = UINT_ONE,
	a,b: a (UINT_SUCC b) | (a : UINT) && (b : UINT) = (UINT_MUL (UINT_POW a b) a);
	(
		forany a1,a2,b2:
		assume condition_1 proves a1 : UINT;
		assume condition_2 proves (a2 : UINT) && (b2 : UINT);
		(_neq_UINT_UINT_ZERO_UINT_SUCC < (condition_2 > and_right)) > or_right
	);
};
syntax (a ** b) = UINT_POW a b, precedence 220, associativity right;

define uint_le a b = (forany c: ((c : UINT) && (b == (a + c))) -> FALSE) -> FALSE;
syntax (a <= b) = uint_le a b, precedence 190, associativity noassoc;

define UINT_SATPRED {
	UINT_ZERO                   = UINT_ZERO,
	a: (UINT_SUCC a) | a : UINT = a;
	(
		forany a:
		assume auint proves a : UINT;
		_neq_UINT_UINT_ZERO_UINT_SUCC < auint
	);
};

define UINT_SATSUB {
	a:   a UINT_ZERO     | a : UINT                 = a,
	a,b: a (UINT_SUCC b) | (a : UINT) && (b : UINT) = UINT_SATSUB (UINT_SATPRED a) b;
	(
		forany a1,a2,b2:
		assume condition_1 proves a1 : UINT;
		assume condition_2 proves (a2 : UINT) && (b2 : UINT);
		(_neq_UINT_UINT_ZERO_UINT_SUCC < (condition_2 > and_right)) > or_right
	);
};

syntax (a - b) = UINT_SATSUB a b, precedence 200, associativity left;



require satpred_uint_is_uint proves forany a: a : UINT -> (UINT_SATPRED a) : UINT
by (
	forany a:
	assume auint proves a : UINT;
	or_cases < (uint_is_zero_or_succ < auint) < (
		assume a_0 proves a == UINT_ZERO;
		
		(zero_is_uint > ((defeq2 UINT_SATPRED.x) > eq_comm) > bin_sub_right_impl)
		>
		((a_0 > eq_comm) > un_sub_arg)
		>
		bin_sub_right_impl
	) < (
		assume a_is_succ proves (forany b: (HAS_MEMBER UINT b -> (eq a (UINT_SUCC b)) -> FALSE)) -> FALSE;
		
		not_not_impl < (
			// Goal:
			// ((UINT_SATPRED a) : UINT -> FALSE) -> FALSE
			
			assume aaa proves (UINT_SATPRED a) : UINT -> FALSE;
			
			// Goal: FALSE
			
			a_is_succ < (
				forany b:
				assume buint proves b : UINT;
				assume a_sb proves a == b++;
				
				// Goal: FALSE
				
				aaa < (
					// Goal: (UINT_SATPRED a) : UINT
					
					require temp1 proves (UINT_SATPRED (b++)) : UINT
					by buint > (((defeq2 UINT_SATPRED.xx) < buint) > eq_comm) > bin_sub_right_impl;
					
					temp1 > ((a_sb > eq_comm) > un_sub_arg) > bin_sub_right_impl
				)
			)
		)
	)
);


require satsub_succ__satpred_satsub proves forany a,b:  a : UINT -> b : UINT -> (a - b++) == UINT_SATPRED (a - b)
by (
	define Func b = forany a: a : UINT -> (a - b++)  == UINT_SATPRED (a - b);
	
	require casezero proves Func UINT_ZERO
	by wrap Func (
		forany a:
		assume auint proves a : UINT;
		
		// Goal:
		// (a - 0++)  == UINT_SATPRED (a - 0)
		
		require temp1 proves UINT_SATPRED (a - UINT_ZERO) == UINT_SATPRED (a - UINT_ZERO)
		by eq_same;
		
		require temp2 proves UINT_SATPRED a == UINT_SATPRED (a - UINT_ZERO)
		by temp1 > ((defeq2 UINT_SATSUB.x < auint) > un_sub_arg) > bin_sub_left_impl;
		
		require temp3 proves (UINT_SATPRED a - UINT_ZERO) == UINT_SATPRED (a - UINT_ZERO)
		by temp2 > ((defeq2 UINT_SATSUB.x < (auint > satpred_uint_is_uint)) > eq_comm) > bin_sub_left_impl;
		
		temp3 > ((defeq2 UINT_SATSUB.xx < (impl_impl_and < auint < zero_is_uint)) > eq_comm) > bin_sub_left_impl
	);
	
	require casesucc proves forany b: b : UINT -> Func b -> Func (b++)
	by (
		forany b:
		assume buint proves b : UINT;
		assume hypoth proves Func b;
		require hypoth_ proves forany a: a : UINT -> (a - b++)  == UINT_SATPRED (a - b)
		by unwrap Func hypoth;
		
		wrap Func (
			forany a:
			assume auint proves a : UINT;
			
			require temp1 proves UINT_SATPRED (UINT_SATPRED a - b) == UINT_SATPRED (UINT_SATPRED a - b)
			by eq_same;
			
			require temp2 proves UINT_SATPRED (UINT_SATPRED a - b) == UINT_SATPRED (a - b++)
			by temp1 > (((defeq2 UINT_SATSUB.xx < (impl_impl_and < auint < buint)) > eq_comm) > un_sub_arg) > bin_sub_right_impl;
			
			require temp3 proves (UINT_SATPRED a - b++) == UINT_SATPRED (a - b++)
			by temp2 > ((hypoth_ < (auint > satpred_uint_is_uint)) > eq_comm) > bin_sub_left_impl;
			
			require temp4 proves (a - (b++)++) == UINT_SATPRED (a - b++)
			by temp3 > ((defeq2 UINT_SATSUB.xx < (impl_impl_and < auint < (succ_uint_is_uint < buint))) > eq_comm) > bin_sub_left_impl;
			
			temp4
		)
	);
	
	forany a,b:
	assume auint proves a : UINT;
	assume buint proves b : UINT;
	
	(unwrap Func (uint_inductive < casezero < casesucc < buint)) < auint
);

define is_divisible_by n o = (n : UINT) && (o : UINT) && !(forany x: !((x : UINT) && x * o == n));

define is_even n = is_divisible_by n UINT_TWO;

define is_prime p = forany d: (p : UINT) && p != UINT_ONE && (d : UINT  ->  d != UINT_ONE  ->  d != p  ->  !(is_divisible_by p d));

define MUL_RANGE {
	a:   a a                      = a,
	a,b: a b | (a <= b && a != b) = a * MUL_RANGE a++ b;
	(
		forany a1,a2,b2:
		assume conditions proves (a2 <= b2 && a2 != b2);
		or_cases < yay_or_nay < (
			assume a1_eq_a2 proves a1 == a2;
			or_right < ((conditions > and_right) > ((a1_eq_a2 > eq_comm) > bin_sub_left_eq) > bin_sub_left_impl)
		) < (
			assume a1_neq_a2 proves a1 != a2;
			or_left < a1_neq_a2
		)
	);
};






require or_assoc_impl proves forany a,b,c: (a || b) || c  ->  a || (b || c)
by (
	forany a,b,c:
	assume AB_C proves (a || b) || c;
	
	require AB_C_ proves AND (or a b -> FALSE) (c -> FALSE) -> FALSE
	by unwrap or AB_C;
	
	wrap or (
		// Goal:
		// AND (a -> FALSE) (or b c -> FALSE) -> FALSE
		
		assume NA_NBC proves AND (a -> FALSE) (or b c -> FALSE);
		
		// Goal:
		// FALSE
		
		require NA proves a -> FALSE by NA_NBC > and_left;
		require NBC proves or b c -> FALSE
		by NA_NBC > and_right;
		
		require NBC_ proves (AND (b -> FALSE) (c -> FALSE) -> FALSE) -> FALSE
		by (
			assume temp proves AND (b -> FALSE) (c -> FALSE) -> FALSE;
			(wrap or temp) > NBC
		);
		
		require NBC__ proves AND (b -> FALSE) (c -> FALSE)
		by NBC_ > not_not_impl;
		
		require NB proves b -> FALSE  by  NBC__ > and_left;
		require NC proves c -> FALSE  by  NBC__ > and_right;
		
		AB_C_ < (
			// Goal:
			// AND (or a b -> FALSE) (c -> FALSE)
			
			impl_impl_and < (
				// Goal:
				// or a b -> FALSE
				
				assume AB proves or a b;
				
				// Goal:
				// FALSE
				
				require AB_ proves AND (a -> FALSE) (b -> FALSE) -> FALSE
				by unwrap or AB;
				
				AB_ < (
					impl_impl_and < NA < NB
				)
			) < NC
		)
	)
);

require not_not_or_not__and proves forany a,b:  (or (a -> FALSE) (b -> FALSE) -> FALSE) -> AND a b
by (
	forany a,b:
	assume not_na_or_nb proves or (a -> FALSE) (b -> FALSE) -> FALSE;
	require temp1 proves (AND ((a -> FALSE) -> FALSE) ((b -> FALSE) -> FALSE) -> FALSE) -> FALSE
	by (
		assume ttt proves AND ((a -> FALSE) -> FALSE) ((b -> FALSE) -> FALSE) -> FALSE;
		wrap or ttt > not_na_or_nb
	);
	
	require temp2 proves AND ((a -> FALSE) -> FALSE) ((b -> FALSE) -> FALSE)
	by temp1 > not_not_impl;
	
	(temp2 > not_not_eq > bin_sub_left_impl) > not_not_eq > bin_sub_right_impl
);













					ccc < (
						// Goal:
						// forSOME c: (c : UINT) && (b == (a++ + c))
						
						// forSOME c: (c : UINT) && (b == (a++ + c))
						// forSOME c: (c : UINT) && (b == (UINT_ZERO++ + c))
						// forSOME c: (c : UINT) && (k++ == (UINT_ZERO++ + c))
						// forSOME c: (k : UINT) && (k++ == (UINT_ZERO++ + k))
						// forSOME c: (k : UINT) && (k++ == (UINT_ZERO + k)++)
						// forSOME c: (k : UINT) && (k++ == k++)
						

						by eq_same > (((zero_add < kuint) > eq_comm) > un_sub_arg) > bin_sub_right_impl;
						
						require temp2 proves k++ == (UINT_ZERO++ + k)
						by temp1 > ((succ_add < zero_is_uint < kuint) > eq_comm) > bin_sub_right_impl;
						

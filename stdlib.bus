	assume B proves b;
	not_ab < (impl_impl_and < A < B)
);

require not_and__right_impl_not_left proves forany a,b: !(a && b) -> b -> !a
by (
	forany a,b:
	assume not_ab proves !(a && b);
	assume B proves b;
	assume A proves a;
	not_ab < (impl_impl_and < A < B)
);








require eq_ltr proves forany a,b: a == b -> (a -> b)
by (
	forany a,b:
	assume AeqB proves a == b;
	(unwrap eq AeqB) > and_left

	)
);

require one_le__not_zero proves forany a: a : UINT  ->  UINT_ONE <= a  ->  a != UINT_ZERO
by (
	forany a:
	assume auint proves a : UINT;
	assume 1_le_a proves UINT_ONE <= a;

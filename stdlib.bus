/*
Language built-ins:
atom IMPLIES;
syntax (a b) = a b, precedence 10000, associativity left;
*/

syntax (a -> b) = IMPLIES a b, precedence 100, associativity right;

assume proofsyntax
	ARGS : (
		( (first:IDENT) (rest:ARGS) ),
		( ),
	),
	
	(
		define (funcname:IDENT) (args:ARGS) = (expr) ;
		(innerproof)
	) = (
		atom ((funcname));
		syntaxassume _def_((funcname))_ltr proves ((make_forany args)) ((funcname)) ((args)) -> ( ((expr)) );
		syntaxassume _def_((funcname))_rtl proves ((make_forany args)) ( ((expr)) ) -> ((funcname)) ((args));
		((innerproof))
	),
	
	make_forany_3 (args:ARGS.0) = ( , ((args.first)) ((make_forany_3 args.rest)) ),
	make_forany_3 (args:ARGS.1) = ( ),
	make_forany_2 (args:ARGS.0) = ( ((args.first)) ((make_forany_3 args.rest)) ),
	make_forany_2 (args:ARGS.1) = ( ),
	make_forany   (args:ARGS.0) = ( forany ((make_forany_2 args)) : ),
	make_forany   (args:ARGS.1) = ( ),
;

proofsyntax
	(
		unwrap (funcname:IDENT) (innerproof)
	) = (
		_def_((funcname))_ltr < ( ((innerproof)) )
	),
;

proofsyntax
	(
		wrap (funcname:IDENT) (innerproof)
	) = (
		_def_((funcname))_rtl < ( ((innerproof)) )
	),
;


assume todo proves forany a: a;

define FALSE = forany a: a;
syntax (!a) = a -> FALSE, precedence 20000, associativity right;
require false_proves_anything proves forany a: FALSE -> a  by ( assume f proves FALSE; unwrap FALSE f );
assume not_not_impl proves forany a: ((a -> FALSE) -> FALSE) -> a;

atom AND;
syntax (a && b) = AND a b, precedence 150, associativity left;
assume and_left  proves forany a,b: (a && b) -> a;
assume and_right proves forany a,b: (a && b) -> b;
assume impl_impl_and proves forany a,b: a -> b -> (a && b);

define eq x y = (x -> y) && (y -> x);
syntax (a == b) = eq a b, precedence 160, associativity noassoc;
syntax (a != b) = !(a == b), precedence 160, associativity noassoc;
assume func_eq proves forany f,g: (f == g) == (forany x,y: x == y -> f x == g y);

define or a b = !(!a && !b);
syntax (a || b) = or a b, precedence 150, associativity left;

define xor a b = (a || b) && !(a && b);
syntax (a ^^ b) = xor a b, precedence 150, associativity left;



atom HAS_MEMBER;
syntax (a : b)  = HAS_MEMBER b a, precedence 200, associativity noassoc;

assume proofsyntax
	(
		enum (enumname:IDENT) {
			(vallist:VAL_LIST)
		};
		(innerproof)
	) = (
		atom ((enumname));
		((make_atoms vallist))
		((make_has_members enumname vallist))
		((make_is_one_of enumname vallist))
		((make_inequalities enumname vallist))
		((innerproof))
	),
	
	CONDITION : (
		( | (condition) ),
		( ),
	),
	
	VAL_ITEM_ARGS : (
		( (first:IDENT) (rest:VAL_ITEM_ARGS) ),
		( ),
	),
	VAL_LIST : (
		( (first_name:IDENT) (first_args:VAL_ITEM_ARGS) (first_condition:CONDITION) , (rest:VAL_LIST) ),
		( ),
		( , ),
	),
	
	
	make_atoms (vallist:VAL_LIST.0) = (
		atom ((vallist.first_name));
		((make_atoms vallist.rest))
	),
	make_atoms (vallist:VAL_LIST.1) = ( ),
	make_atoms (vallist:VAL_LIST.2) = ( ),
	
	
	make_inequality__arg_list enumname name (args:VAL_ITEM_ARGS.0) = (
		_((enumname))_((name))_((args.first))
		((make_inequality__arg_list enumname name args.rest))
	),
	make_inequality__arg_list enumname name (args:VAL_ITEM_ARGS.1) = ( ),
	make_inequality__forany_3 enumname first_name (first_args:VAL_ITEM_ARGS.1) second_name (second_args:VAL_ITEM_ARGS.1) = ( ),
	make_inequality__forany_3 enumname first_name (first_args:VAL_ITEM_ARGS.1) second_name (second_args:VAL_ITEM_ARGS.0) = (
		, _((enumname))_((second_name))_((second_args.first))
		((make_inequality__forany_3 enumname first_name first_args second_name second_args.rest))
	),
	make_inequality__forany_3 enumname first_name (first_args:VAL_ITEM_ARGS.0) second_name (second_args:VAL_ITEM_ARGS) = (
		, _((enumname))_((first_name))_((first_args.first))
		((make_inequality__forany_3 enumname first_name first_args.rest second_name second_args))
	),
	make_inequality__forany enumname first_name (first_args:VAL_ITEM_ARGS.1) second_name (second_args:VAL_ITEM_ARGS.1) = ( ),
	make_inequality__forany enumname first_name (first_args:VAL_ITEM_ARGS.0) second_name second_args = (
		forany _((enumname))_((first_name))_((first_args.first))
		((make_inequality__forany_3 enumname first_name first_args.rest second_name second_args))
		:
	),
	make_inequality__forany enumname first_name first_args second_name (second_args:VAL_ITEM_ARGS.0) = (
		forany _((enumname))_((second_name))_((second_args.first))
		((make_inequality__forany_3 enumname first_name first_args second_name second_args.rest))
		:
	),
	make_inequality enumname first_name first_args first_condition second_name second_args second_condition = (
		syntaxassume _neq_((enumname))_((first_name))_((second_name))
		proves
			((make_inequality__forany enumname first_name first_args second_name second_args))
			((make_inequality_condition first_condition  enumname first_name first_args))
			((make_inequality_condition second_condition enumname second_name second_args))
			((first_name))
			((make_inequality__arg_list enumname first_name first_args))
		!=
			((second_name))
			((make_inequality__arg_list enumname second_name second_args))
		;
	),
	make_inequalities_2 enumname first_name first_args first_condition (vallist:VAL_LIST.0) = (
		((make_inequality enumname first_name first_args first_condition vallist.first_name vallist.first_args vallist.first_condition))
		((make_inequalities_2 enumname first_name first_args first_condition vallist.rest))
	),
	make_inequalities_2 enumname first_name first_args first_condition (vallist:VAL_LIST.1) = ( ),
	make_inequalities_2 enumname first_name first_args first_condition (vallist:VAL_LIST.2) = ( ),
	make_inequalities enumname (vallist:VAL_LIST.0) = (
		((make_inequalities_2 enumname vallist.first_name vallist.first_args vallist.first_condition vallist.rest))
	),
	make_inequalities enumname (vallist:VAL_LIST.1) = ( ),
	make_inequalities enumname (vallist:VAL_LIST.2) = ( ),
	
	replace_arg_names input enumname name (args:VAL_ITEM_ARGS.0) = ( ((replace_ident args.first (concat "_" enumname "_" name "_" args.first) (replace_arg_names input enumname name args.rest))) ),
	replace_arg_names input enumname name (args:VAL_ITEM_ARGS.1) = ( ((input)) ),
	
	make_inequality_condition (condition:CONDITION.0) enumname name args = ( ( ((replace_arg_names condition.condition enumname name args)) ) -> ),
	make_inequality_condition (condition:CONDITION.1) enumname name args = ( ),
	
	make_forany_2 (args:VAL_ITEM_ARGS.0) = ( , ((args.first)) ((make_forany_2 args.rest)) ),
	make_forany_2 (args:VAL_ITEM_ARGS.1) = ( ),
	make_forany (args:VAL_ITEM_ARGS.0) = (
		forany ((args.first)) ((make_forany_2 args.rest)) :
	),
	make_forany (args:VAL_ITEM_ARGS.1) = ( ),
	
	make_has_member_maybe_condition (condition:CONDITION.0) = ( ( ((condition.condition)) ) -> ),
	make_has_member_maybe_condition (condition:CONDITION.1) = ( ),
	make_has_members enumname (vallist:VAL_LIST.0) = (
		syntaxassume _((enumname))_has_member_((vallist.first_name)) proves ((make_forany vallist.first_args)) ((make_has_member_maybe_condition vallist.first_condition)) HAS_MEMBER ((enumname)) ( ((vallist.first_name)) ((vallist.first_args)) );
		((make_has_members enumname vallist.rest))
	),
	make_has_members enumname (vallist:VAL_LIST.1) = ( ),
	
	make_is_one_of__maybe_condition (condition:CONDITION.0) = ( ( ((condition.condition)) ) && ),
	make_is_one_of__maybe_condition (condition:CONDITION.1) = ( ),
	make_is_one_of_4 (vallist:VAL_LIST.0) = (
		( ( ((make_forany vallist.first_args)) ( ((make_is_one_of__maybe_condition vallist.first_condition)) xxx == ((vallist.first_name)) ((vallist.first_args)) )  -> FALSE ) -> FALSE )
	),
	make_is_one_of_3 (vallist:VAL_LIST.0) = ( || ((make_is_one_of_4 vallist)) ((make_is_one_of_3 vallist.rest)) ),
	make_is_one_of_3 (vallist:VAL_LIST.1) = ( ),
	make_is_one_of_2 (vallist:VAL_LIST.0) = (
		((make_is_one_of_4 vallist)) ((make_is_one_of_3 vallist.rest))
	),
	make_is_one_of enumname (vallist:VAL_LIST.0) = (
		syntaxassume _((enumname))_is_one_of proves forany xxx: (HAS_MEMBER UINT xxx) -> ( ((make_is_one_of_2 vallist)) ) ;
	),
;




assume proofsyntax
	(
		define (funcname:IDENT) {
			(branch_list:BRANCH_LIST) ;
			(inequality_proofs:INEQUALITY_PROOFS) ;
		};
		(innerproof)
	) = (
		atom ((funcname));
		((make_equalities funcname branch_list "x"))
		scope (
			((make_requirements funcname branch_list inequality_proofs "x"))
		);
		((innerproof))
	),
	INEQUALITY_PROOFS : (
		( (proof) , (rest:INEQUALITY_PROOFS) ),
		( (proof) ),
	),
	CONDITION : (
		( | (condition) ),
		( ),
	),
	BRANCH_LIST : (
		( (branch:BRANCH) , (rest:BRANCH_LIST) ),
		( (branch:BRANCH) ),
	),
	BRANCH : (
		( (vars:BRANCH_VARS) : (lhs_args_maybe:LHS_ARGS_MAYBE) (condition:CONDITION) = (rhs) ),
		( (lhs_args_maybe:LHS_ARGS_MAYBE) (condition:CONDITION) = (rhs) ),
	),
	BRANCH_VARS : (
		( (first:IDENT) , (rest:BRANCH_VARS) ),
		( (first:IDENT) ),
	),
	LHS_ARG : (
		( (ident:IDENT) ),
		( (paren:PAREN) ),
	),
	LHS_ARGS_MAYBE : (
		( (lhs_args:LHS_ARGS) ),
		( ),
	),
	LHS_ARGS : (
		( (arg:LHS_ARG) (rest:LHS_ARGS) ),
		( (arg:LHS_ARG) ),
	),
	make_equalities funcname (branch_list:BRANCH_LIST.0) counter = (
		((make_equality funcname branch_list.branch counter))
		((make_equalities funcname branch_list.rest (concat counter "x")))
	),
	make_equalities funcname (branch_list:BRANCH_LIST.1) counter = (
		((make_equality funcname branch_list.branch counter))
	),
	make_condition (condition:CONDITION.0) = ( ( ((condition.condition)) ) -> ),
	make_condition (condition:CONDITION.1) = ( ),
	make_equality funcname (branch:BRANCH.0) counter = (
		syntaxassume _def_((funcname))_((counter)) proves forany ((branch.vars)) : ((make_condition branch.condition)) ((funcname)) ((branch.lhs_args_maybe)) == ( ((branch.rhs)) );
	),
	make_equality funcname (branch:BRANCH.1) counter = (
		syntaxassume _def_((funcname))_((counter)) proves ((make_condition branch.condition)) ((funcname)) ((branch.lhs_args_maybe)) == ( ((branch.rhs)) );
	),
	
	make_requirements_3 funcname (branch_list_1:BRANCH_LIST.0) (branch_list_2:BRANCH_LIST.0) inequality_proofs counter = (
		((make_requirement funcname branch_list_1.branch branch_list_2.branch inequality_proofs.proof counter))
		((make_requirements_3 funcname branch_list_1 branch_list_2.rest inequality_proofs.rest (concat counter "x")))
	),
	make_requirements_3 funcname (branch_list_1:BRANCH_LIST.0) (branch_list_2:BRANCH_LIST.1) (inequality_proofs:INEQUALITY_PROOFS.0) counter = (
		((make_requirement funcname branch_list_1.branch branch_list_2.branch inequality_proofs.proof counter))
		((make_requirements funcname branch_list_1.rest inequality_proofs.rest (concat counter "x")))
	),
	make_requirements_3 funcname (branch_list_1:BRANCH_LIST.0) (branch_list_2:BRANCH_LIST.1) (inequality_proofs:INEQUALITY_PROOFS.1) counter = (
		((make_requirement funcname branch_list_1.branch branch_list_2.branch inequality_proofs.proof counter))
	),
	// TODO error when there are too many proofs
	make_requirements funcname (branch_list_1:BRANCH_LIST.1) inequality_proofs counter = ( ),
	make_requirements funcname (branch_list_1:BRANCH_LIST.0) inequality_proofs counter = (
		((make_requirements_3 funcname branch_list_1 branch_list_1.rest inequality_proofs counter))
	),
	make_requirements_3 funcname (branch_list_1:BRANCH_LIST.1) branch_list_2 inequality_proofs = ( ),
	
	make_requirement_forany_2 (vars:BRANCH_VARS.0) suffix = ( ((vars.first))((suffix)) , ((make_requirement_forany_2 vars.rest suffix)) ),
	make_requirement_forany_2 (vars:BRANCH_VARS.1) suffix = ( ((vars.first))((suffix)) ),
	make_requirement_forany (first:BRANCH.0) (second:BRANCH.0) = (
		forany ((make_requirement_forany_2 first.vars "_1")) , ((make_requirement_forany_2 second.vars "_2")) :
	),
	make_requirement_forany (first:BRANCH.0) (second:BRANCH.1) = (
		forany ((make_requirement_forany_2 first.vars "_1")) :
	),
	make_requirement_forany (first:BRANCH.1) (second:BRANCH.0) = (
		forany ((make_requirement_forany_2 second.vars "_2")) :
	),
	make_requirement_forany (first:BRANCH.1) (second:BRANCH.1) = ( ),
	make_requirement funcname (first:BRANCH) (second:BRANCH) inequality_proof counter = (
		require _def_((funcname))_((counter)) proves ((make_requirement_forany first second)) ((make_inequality_condition first "_1")) ((make_inequality_condition second "_2")) ((make_inequalities first second first.lhs_args_maybe.lhs_args second.lhs_args_maybe.lhs_args))
			by ((inequality_proof)) ;
	),
	
	make_forany_var_replacements (a:BRANCH_VARS.0) suffix expr
		= ( ((replace_ident a.first (concat a.first suffix) (make_forany_var_replacements a.rest suffix expr))) ),
	make_forany_var_replacements (a:BRANCH_VARS.1) suffix expr
		= ( ((replace_ident a.first (concat a.first suffix) expr)) ),
	
	make_inequality_condition_without_vars (condition:CONDITION.0) = ( ( ((condition.condition)) ) -> ),
	make_inequality_condition_without_vars (condition:CONDITION.1) = ( ),
	make_inequality_condition_with_vars (vars:BRANCH_VARS) suffix (condition:CONDITION.0) = ( ( ((make_forany_var_replacements vars suffix condition.condition)) ) -> ),
	make_inequality_condition_with_vars (vars:BRANCH_VARS) suffix (condition:CONDITION.1) = ( ),
	make_inequality_condition (branch:BRANCH.0) suffix = ( ((make_inequality_condition_with_vars branch.vars suffix branch.condition)) ),
	make_inequality_condition (branch:BRANCH.1) suffix = ( ((make_inequality_condition_without_vars branch.condition)) ),
	
	arg_with_var_replacements (branch:BRANCH.0) suffix (arg:LHS_ARG) = ( ( ((make_forany_var_replacements branch.vars suffix arg)) ) ),
	arg_with_var_replacements (branch:BRANCH.1) suffix (arg:LHS_ARG) = ( ( ((arg)) ) ),
	
	make_inequality (a:BRANCH) (b:BRANCH) (first_arg:LHS_ARG) (second_arg:LHS_ARG) = (
		((arg_with_var_replacements a "_1" first_arg)) != ((arg_with_var_replacements b "_2" second_arg))
	),
	
	make_inequalities (a:BRANCH) (b:BRANCH) (first_args:LHS_ARGS.0) (second_args:LHS_ARGS.0) = (
		((make_inequality a b first_args.arg second_args.arg)) || ((make_inequalities a b first_args.rest second_args.rest))
	),
	make_inequalities (a:BRANCH) (b:BRANCH) (first_args:LHS_ARGS.1) (second_args:LHS_ARGS.1) = (
		((make_inequality a b first_args.arg second_args.arg))
	),
	make_inequalities (a:BRANCH) (b:BRANCH) (first_args:LHS_ARGS.1) (second_args:LHS_ARGS.0) = ( ((error "Define branches must have same amount of arguments")) ),
	make_inequalities (a:BRANCH) (b:BRANCH) (first_args:LHS_ARGS.0) (second_args:LHS_ARGS.1) = ( ((error "Define branches must have same amount of arguments")) ),
;

proofsyntax
	( unwrap2 (funcname:IDENT).(counter:IDENT) (innerproof) ) =
	( ( _def_((funcname))_((counter)) > eq_ltr ) < ( ((innerproof)) ) );

proofsyntax
	( wrap2 (funcname:IDENT).(counter:IDENT) (innerproof) ) =
	( ( _def_((funcname))_((counter)) > eq_rtl) < ( ((innerproof)) ) );

proofsyntax
	( defeq2 (funcname:IDENT).(counter:IDENT) ) =
	( _def_((funcname))_((counter)) );

enum UINT {
	UINT_ZERO,
	UINT_SUCC prev | prev : UINT,
};





require impl_same proves forany a: a -> a
by (
	forany a:
	assume A proves a;
	A
);

require impl_reverse proves forany a,b: (a -> b) -> (!b -> !a)
by (
	forany a,b:
	assume AB proves a -> b;
	assume BF proves b -> FALSE; // !b
	assume A proves a;
	(A > AB) > BF
);

require impl_not_not proves forany a: a -> !!a
by (
	forany a:
	assume A proves a;
	assume NA proves (a -> FALSE);
	A > NA
);

require not_not_eq proves forany a: ((a -> FALSE) -> FALSE) == a
by (
	wrap eq (impl_impl_and < not_not_impl < impl_not_not)
);

require left_impl_not_right__not_and proves forany a,b: (a -> !b) -> !(a && b)
by (
	forany a,b:
	assume a_nb proves a -> !b;
	assume a_and_b proves a && b;
	a_nb < (a_and_b > and_left) < (a_and_b > and_right)
);

require right_impl_not_left__not_and proves forany a,b: (b -> !a) -> !(a && b)
by (
	forany a,b:
	assume b_na proves b -> !a;
	assume a_and_b proves a && b;
	b_na < (a_and_b > and_right) < (a_and_b > and_left)
);

require yay_or_nay proves forany a: a || !a
by (
	forany aa:
	require temp proves !(!aa && !!aa)
	by (substitute a=!aa in impl_not_not) > left_impl_not_right__not_and;
	wrap or temp
);

require or__not_left__right proves forany a,b: a || b  ->  !a -> b
by (
	forany a,b:
	assume A_OR_B proves a || b;
	assume NA proves !a;
	require A_OR_B_ proves !(!a && !b)
	by unwrap or A_OR_B;
	
	not_not_impl < (
		// Goal:
		// !!b
		assume NB proves !b;
		A_OR_B_ < (NB > NA > impl_impl_and)
	)
);

require or__not_right__left proves forany a,b: a || b  ->  !b -> a
by (
	forany a,b:
	assume A_OR_B proves a || b;
	assume NB proves !b;
	require A_OR_B_ proves !(!a && !b)
	by unwrap or A_OR_B;
	
	not_not_impl < (
		// Goal:
		// !!a
		assume NA proves !a;
		A_OR_B_ < (NB > NA > impl_impl_and)
	)
);

require impl_weaken proves forany a,b: a -> (b -> a)
by (
	forany a,b:
	assume A proves a;
	assume _ proves b;
	A
);

require impl_trans proves forany a,b,c: (a -> b) -> (b -> c) -> (a -> c)
by (
	forany a,b,c:
	assume AB proves a -> b;
	assume BC proves b -> c;
	assume A proves a;
	(A > AB) > BC
);

require impl_impl_impl__and_impl proves forany a,b,c: (a -> b -> c) -> (a && b -> c)
by (
	forany a,b,c:
	assume abc proves a -> b -> c;
	assume ab proves a && b;
	(ab > and_right) > (ab > and_left) > abc
);

require impl_reverse_back proves forany a,b: (!b -> !a) -> (a -> b)
by (
	forany a,b:
	assume NB_NA proves !b -> !a;
	assume A proves a;
	((A > impl_not_not) > (NB_NA > impl_reverse)) > not_not_impl
);



require or_cases proves forany a,b,c: a || b  ->  (a -> c)  ->  (b -> c)  ->  c
by (
	forany a,b,c:
	assume ab proves a || b;
	assume a_c proves a -> c;
	assume b_c proves b -> c;
	
	require nc_na proves !c -> !a   by  a_c > impl_reverse;
	require nc_nb proves !c -> !b   by  b_c > impl_reverse;
	
	not_not_impl < (
		// Goal:
		// !!c
		
		assume nc proves !c;
		
		// Goal:
		// FALSE
		
		(unwrap or ab) < (
			// Goal:
			// !a && !b
			
			impl_impl_and < (nc > nc_na) < (nc > nc_nb)
		)
	)
);




require by_contradiction proves forany a: (a -> !a) -> !a
by (
	forany a:
	assume A_NA proves a -> !a;
	assume A proves a;
	A > (A > A_NA)
);

require by_contradiction_2 proves forany a: (!a -> a) -> a
by (
	forany a:
	assume NA_A proves !a -> a;
	NA_A > impl_same > yay_or_nay > or_cases
);















require eq_same proves forany a: a == a
by (
	wrap eq (impl_same > impl_same > impl_impl_and)
);









require wrap_in_func_impl proves forany f,a,b: a == b  ->  (f a) == (f b)
by (
	forany f,a,b:
	assume AB proves eq a b;
	AB > eq_same > ((unwrap eq func_eq) > and_left)
);

require lhs_rhs_eq proves forany f,g,a,b: f == g  ->  a == b  ->  (f a) == (g b)
by (
	(unwrap eq func_eq) > and_left
);

require bin_sub_left_impl proves forany f,a,b,x: a == b  ->  f a x  ->  f b x
by (
	forany f,a,b,x:
	assume AB proves eq a b;
	assume FAX proves f a x;
	
	require FA_FB proves eq (f a) (f b)   by   AB > eq_same > lhs_rhs_eq;
	
	FAX > ((unwrap eq (eq_same > FA_FB > lhs_rhs_eq)) > and_left)
);

require bin_sub_left_eq proves forany f,a,b,x: a == b  ->  (f a x) == (f b x)
by (
	forany f,a,b,x:
	assume AB proves eq a b;
	eq_same > (AB > (substitute f=f in wrap_in_func_impl)) > lhs_rhs_eq
);

require bin_sub_right_impl proves forany f,a,b,x: a == b  ->  f x a  ->  f x b
by (
	forany f,a,b,x:
	assume AB proves eq a b;
	assume FXA proves f x a;
	FXA > (unwrap eq (AB > eq_same > lhs_rhs_eq) > and_left)
);

require bin_sub_right_eq proves forany f,a,b,x: a == b  ->  (f x a) == (f x b)
by (
	forany f,x,a,b:
	assume AB proves eq a b;
	AB > (substitute a=(f x) in eq_same) > lhs_rhs_eq
);







require un_sub_arg proves forany f,a,b: a == b  ->  (f a) == (f b)
by wrap_in_func_impl;

require wrap_in_bin_func_lhs proves forany f,a,b,c: a == b  ->  (f a c) == (f b c)
by (

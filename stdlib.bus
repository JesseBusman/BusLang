		one_not_prime < (aprime > ((a_1 > un_sub_arg) > eq_ltr))
	);
	not_zero_not_one__2_le < ((unwrap is_prime aprime > and_left) > and_left) < a_not_0 < a_not_1
);

require even_not_two_not_prime proves forany n: is_even n  ->  n != UINT_TWO  ->  !(is_prime n)

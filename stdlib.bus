						(ba > eq_comm) > a_not_b
					);
					
					require d_is_succ proves (forany r: (r : UINT -> (d == r++) -> FALSE)) -> FALSE
					by or__not_left__right < (uint_is_zero_or_succ < duint) < d_not_0;
					
					d_is_succ < (
						// Goal:
